class Solution {
    public int subarraysDivByK(int[] nums, int k) {
        // Array to store the frequency of each remainder (from 0 to k-1)
        int[] remainderCounts = new int[k];
        
        // Base case: A remainder of 0 has occurred 1 time (before the array starts)
        remainderCounts[0] = 1;
        
        int count = 0;
        int prefixSum = 0;
        
        for (int i = 0; i < nums.length; i++) {
            prefixSum += nums[i];
            
            // Calculate the remainder of the current prefix sum
            int remainder = prefixSum % k;
            
            // Fix negative remainders in Java
            if (remainder < 0) {
                remainder += k;
            }
            
            // Add the number of times we've seen this remainder before to our total count
            count += remainderCounts[remainder];
            
            // Record the occurrence of this remainder for future subarrays
            remainderCounts[remainder]++;
        }
        
        return count;
    }
}